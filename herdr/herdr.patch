+#[test]
+fn switch_workspace_index_spans_online_endpoints() {
+    let (mut state, endpoint_id) = state_with_remote();
+    let targets = state.aggregate_workspace_targets();
+    let index = targets
+        .iter()
+        .position(|(endpoint, _)| endpoint == &endpoint_id)
+        .expect("remote workspace in aggregate order");
+    assert!(index > 0, "local workspaces come first");
+    let switch = |index| {
+        crate::input::KeybindMatch::Action(crate::input::KeybindAction::SwitchWorkspace(index))
+    };
+
+    assert!(state.indexed_navigation_target_exists(&switch(0)));
+    assert!(state.indexed_navigation_target_exists(&switch(index)));
+    assert!(!state.indexed_navigation_target_exists(&switch(targets.len())));
+
+    let mut outcome = ClientShellInput::default();
+    state.record_binding(switch(index), &mut outcome);
+    assert!(matches!(
+        &outcome.actions[..],
+        [ClientShellAction::ActivateEndpoint {
+            endpoint_id: target,
+            target: Some(ClientEndpointFocusTarget::Workspace(workspace_id)),
+        }] if target == &endpoint_id && workspace_id == &targets[index].1
+    ));
+
+    let mut outcome = ClientShellInput::default();
+    state.record_binding(switch(targets.len()), &mut outcome);
+    assert!(outcome.actions.is_empty());
+
+    state.set_endpoint_status(&endpoint_id, ClientEndpointStatus::Reconnecting);
+    assert!(!state.indexed_navigation_target_exists(&switch(index)));
+}
