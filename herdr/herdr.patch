+pub(super) fn online_workspace_targets<'a>(
+    endpoints: &'a [ClientShellEndpoint],
+    collapsed_groups: impl Fn(&ClientEndpointId) -> Option<&'a HashSet<String>>,
+) -> Vec<(ClientEndpointId, String)> {
+    let empty = HashSet::new();
+    let mut targets = Vec::new();
+    for endpoint in endpoints
+        .iter()
+        .filter(|endpoint| endpoint.status == ClientEndpointStatus::Online)
+    {
+        let Some(snapshot) = endpoint.snapshot.as_deref() else {
+            continue;
+        };
+        let groups = collapsed_groups(&endpoint.endpoint_id).unwrap_or(&empty);
+        for entry in render::workspace_entries(snapshot, groups) {
+            if let Some(workspace) = snapshot.workspaces.get(entry.index) {
+                targets.push((endpoint.endpoint_id.clone(), workspace.workspace_id.clone()));
+            }
+        }
+    }
+    targets
+}
