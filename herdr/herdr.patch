+#[test]
+fn sidebar_index_tokens_match_aggregate_positions() {
+    let (mut state, endpoint_id) = state_with_remote();
+    let mut config = Config::default();
+    config.ui.sidebar.spaces.rows = vec![vec![
+        crate::config::SpaceSidebarToken::Index,
+        crate::config::SpaceSidebarToken::Workspace,
+    ]];
+    config.ui.sidebar.agents.rows = vec![vec![
+        crate::config::AgentSidebarToken::Index,
+        crate::config::AgentSidebarToken::Agent,
+    ]];
+    state.config = ClientShellConfig::from_config(&config);
+    let frame = state.compose(100, 40).expect("aggregate sidebar");
+    let buffer = frame.to_ratatui_buffer().expect("frame should reconstruct");
+    let row_text = |rect: Rect| {
+        (rect.x..rect.right())
+            .map(|x| buffer[(x, rect.y)].symbol().to_string())
+            .collect::<String>()
+    };
+    let targets = state.aggregate_workspace_targets();
+    for (position, (endpoint, workspace_id)) in targets.iter().enumerate() {
+        let hit = state
+            .hits
+            .workspaces
+            .iter()
+            .find(|hit| &hit.endpoint_id == endpoint && &hit.workspace_id == workspace_id)
+            .expect("workspace row");
+        assert!(
+            row_text(hit.rect).contains(&format!("{} ", position + 1)),
+            "workspace {workspace_id} on {endpoint:?} shows index {}",
+            position + 1
+        );
+    }
+    let remote_workspace = targets
+        .iter()
+        .position(|(endpoint, _)| endpoint == &endpoint_id)
+        .expect("remote workspace");
+    assert_eq!(remote_workspace, targets.len() - 1);
+}
