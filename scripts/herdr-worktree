#!/bin/zsh
# Prompt for a branch name, create <repo>_worktree/<branch> next to the repo, open it in a new herdr tab.
# Run from a herdr popup (prefix+shift+w); Escape aborts.
setopt null_glob
bindkey -N p main
bindkey -M p '\e' send-break
name=
vared -M p -p 'branch: ' name
[ -n "$name" ] || exit

root=$(git -C "$HERDR_ACTIVE_PANE_CWD" worktree list --porcelain | head -1 | sed 's/^worktree //')
worktree_dir="${root}_worktree"
mkdir -p "$worktree_dir"
git -C "$root" worktree add "$worktree_dir/$name" -b "$name"

if [ "$WORKTREE_NO_LINK_VENV" != "1" ] && [ -d "$root/.venv" ]; then
    ln -s "$root/.venv" "$worktree_dir/$name/.venv"
fi

# .env / .env.remote are gitignored, so `worktree add` never brings them. Copy
# rather than symlink: SkyPilot rsyncs file_mounts with -Pavz (no --copy-links),
# so a symlinked .env.remote would arrive on the remote dangling.
for f in "$root"/.env "$root"/.env.*; do
    [ -f "$f" ] && cp "$f" "$worktree_dir/$name/"
done

[ -f "$worktree_dir/$name/.envrc" ] && direnv allow "$worktree_dir/$name"

"$HERDR_BIN_PATH" tab create --cwd "$worktree_dir/$name" --label "$name" --focus
