{
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "mcp__clipboard__copy",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "AskUserQuestion"
    ],
    "defaultMode": "auto",
    "blockReadsOutsideWorkingDirectories": false
  },
  "model": "opus",
  "outputStyle": "Concise",
  "sandbox": {
    "enabled": false
  },
  "feedbackDrafts": "off",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "editorMode": "vim",
  "isolatePeerMachines": false,
  "crossSessionInbound": "accept"
}
